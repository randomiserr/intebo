; ============================================================
; Konfigurace aplikace Intebo - SABLONA
; Soubor config.ini je v .gitignore
; ============================================================

[paths]
; Cesta ke slozce s daty (plany, poznamky, inventar).
; Pouzivejte UNC cestu (\\server\sdilene)
;
data_dir =

[server]
; - localhost  = jen tento pocitac
; - 0.0.0.0    = vsechny sitove karty
host = localhost

; Cislo portu
port = 8000
